{
  "name": "case-converter",
  "displayName": "case-converter",
  "description": "Преобразование текста и ключей JSON из snake_case в camelCase",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:case-converter.convertStyles"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "case-converter.convertStyles",
        "title": "Convert Styles"
      }
    ]
  },
  "publisher": "kirill",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "docs": "typedoc --out docs src/converter.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KirillLegenda/case-converter.git"
  }
}
